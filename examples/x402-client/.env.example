# Test wallets for the x402 client. Fund with a few cents of USDC; gas is not needed (x402 exact payments are gasless for the payer).
# Never commit a real key. Both are optional: without a key the client skips that network.
TEST_WALLET_EVM_KEY=0x...        # Base: 32-byte hex private key
TEST_WALLET_SOLANA_KEY=...       # Solana: base58 64-byte secret key (what `solana-keygen` writes, base58-encoded)
# X402_BASE=https://fzorkxvrcbwlrolpotkf.supabase.co/functions/v1/x402
